# Trading system environment template. Copy to .env and fill in.
# NO VALUE IN THIS FILE IS A REAL SECRET.
#
# Every name is TRADING_-prefixed on purpose. The retired system used
# unprefixed names, and that is how two systems silently end up sharing a
# bot and a billing account. Do not remove the prefixes, and do not copy
# any value from the retired system.

# --- Database, one credential per capability -------------------------
# Each is a separate LOGIN role, provisioned immediately before the
# process that uses it deploys -- never earlier, never shared. A single
# shared credential would collapse the boundaries the schema enforces.
TRADING_DATABASE_URL_MD_INGEST=postgresql://md_ingest_proc:<password>@<pooler-host>:6543/postgres
TRADING_DATABASE_URL_FEATURE_ENGINE=postgresql://feature_engine_proc:<password>@<pooler-host>:6543/postgres
TRADING_DATABASE_URL_SETUP_DETECTOR=postgresql://setup_detector_proc:<password>@<pooler-host>:6543/postgres
TRADING_DATABASE_URL_ANALYST=postgresql://analyst_proc:<password>@<pooler-host>:6543/postgres
TRADING_DATABASE_URL_REVIEWER=postgresql://reviewer_proc:<password>@<pooler-host>:6543/postgres
TRADING_DATABASE_URL_DELIVERY=postgresql://delivery_proc:<password>@<pooler-host>:6543/postgres
TRADING_DATABASE_URL_CONTROL=postgresql://trading_control_proc:<password>@<pooler-host>:6543/postgres

# --- Migration / CI --------------------------------------------------
# Used only by scripts/check_migration_ledger_parity.py to read the
# applied ledger. Needs read access to supabase_migrations.
TRADING_MIGRATION_DSN=

# --- Service ---------------------------------------------------------
PORT=8080

# --- NOT PROVISIONED BY T-001 ----------------------------------------
# These belong to later tickets and are listed only so the naming
# convention is settled before anyone needs them. Do not create the
# credentials until the ticket that uses them.
#   TRADING_TELEGRAM_BOT_TOKEN     (delivery -- a NEW bot, never a shared one)
#   TRADING_TELEGRAM_CHAT_ID
#   TRADING_MODEL_API_KEY          (analyst / reviewer)
#   TRADING_UW_API_TOKEN           (ingestion)
#   TRADING_FRED_API_KEY           (ingestion)
#   TRADING_TV_WEBHOOK_HMAC_SECRET (ingestion -- HMAC, not a shared secret compare)
