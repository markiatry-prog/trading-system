# Secrets -- never committed. The .env.example template is the only
# environment file that belongs in version control.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*credential*
*secret*
*service_role*
*service-role*

# Supabase CLI local state
supabase/.branches/
supabase/.temp/

# Python
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
